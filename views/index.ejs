<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>

  <body>
    
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap');
      /* Frutiger Aero inspired Aero, futuristic, rounded font approximation using Montserrat */
      body {
        font-family: 'Montserrat', Arial, sans-serif;
        background: linear-gradient(135deg, #bfe8ff 0%, #70cfef 100%);
        color: #24475b;
        margin: 0;
        min-height: 100vh;
      }
      nav {
        font-family: 'Montserrat', Arial, sans-serif;
        background: rgba(0, 73, 142, 0.9);
        box-shadow: 0 4px 16px rgba(0, 40, 83, 0.14);
      }
      nav ul li a:hover {
        color: #30d5c8;
        text-shadow: 0 1px 7px #fffdda50;
      }
      header {
        background: linear-gradient(90deg, rgba(48,213,200,0.40) 0%, rgba(112,207,239,0.30) 50%, rgba(191,232,255,0.40) 100%), url('https://images.unsplash.com/photo-1464983953574-0892a716854b?auto=format&fit=crop&w=1200&q=80');
        background-size: cover;
        background-position: center;
        border-bottom-left-radius: 26px;
        border-bottom-right-radius: 26px;
        box-shadow: 0 6px 16px rgba(39, 116, 155, 0.16);
      }
      .section {
        background: rgba(255,255,255,0.8);
        margin: 2rem auto;
        padding: 2.5rem 2rem;
        max-width: 920px;
        border-radius: 20px;
        box-shadow: 0 2px 12px rgba(34, 71, 91, 0.07);
        backdrop-filter: blur(1.5px);
      }
      .section h3 {
        font-size: 1.6rem;
        color: #198fb7;
        margin-bottom: 1rem;
        letter-spacing: 1.2px;
      }
      .info-cards {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: center;
        margin-bottom: 1.5rem;
      }
      .info-card {
        background: linear-gradient(120deg, #c1e8fa 40%, #62e0e0 110%);
        border-radius: 16px;
        box-shadow: 0 1px 10px rgba(112,207,239,0.16);
        padding: 1.5rem;
        min-width: 220px;
        max-width: 290px;
        flex: 1 1 250px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .info-card img {
        border-radius: 12px;
        margin-bottom: 1rem;
      }
      .info-card h4 {
        margin-top: 0;
        color: #009ddc;
        font-weight: 700;
      }
      .faculty-list, .program-list {
        margin-left: 1.1rem;
        font-size: 1.06rem;
      }
      .cta {
        background: linear-gradient(90deg, #009ddc 0%, #30d5c8 100%);
        color: #fff;
        border-radius: 10px;
        font-size: 1.2rem;
        text-align: center;
        padding: 1.2rem 1.5rem;
        margin-bottom: 2rem;
        letter-spacing: 1.2px;
        box-shadow: 0 2px 16px #30d5c855;
      }
      @media (max-width: 799px) {
        .info-cards { flex-direction: column; align-items: center; }
      }
    </style>
    
    <main>
      
    <!-- Main Navigation Bar -->
    <nav>
      <ul style="display: flex; gap: 2rem; justify-content: center; padding: 1.5rem 0; list-style: none; margin: 0;">
        <li><a href="#home" style="color: #fff; font-weight: 600; text-decoration: none;">Home</a></li>
        <li><a href="#programs" style="color: #fff; font-weight: 600; text-decoration: none;">Programs</a></li>
        <li><a href="#faculty" style="color: #fff; font-weight: 600; text-decoration: none;">Faculty</a></li>
        <li><a href="#admissions" style="color: #fff; font-weight: 600; text-decoration: none;">Admissions</a></li>
        <li><a href="#contact" style="color: #fff; font-weight: 600; text-decoration: none;">Contact</a></li>
      </ul>
    </nav>
    
    <!-- Header / Hero Section -->
    <header id="home" style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height: 320px; text-align:center; padding: 2.5rem 0 1.5rem;">
      <h1 style="font-size:2.5rem; font-weight:700; color:#009ddc; margin-bottom:1.2rem; text-shadow:0 2px 12px #fffdda23;">
        Empower Your Future with Professional Training
      </h1>
      <p style="max-width: 540px; color: #24475b; font-size: 1.19rem; margin-bottom: 1.2rem;">
        Discover practical, hands-on learning that opens doors to your career. Our FP programs help you build real-world skills in technology, business, healthcare, and more.
      </p>
      <a href="#admissions" style="padding: 0.9rem 2.3rem; background: linear-gradient(90deg, #009ddc 0%, #30d5c8 100%); color: #fff; border: none; border-radius: 17px; font-size: 1.1rem; font-weight:600; box-shadow:0 2px 10px #70cfef35; text-decoration: none; transition: background 0.15s;">
        Apply Now
      </a>
    </header>

    <!-- Recap Section / Overview (as Home/Main Section) -->
    <section class="section" style="margin-top:2rem;" id="overview">
      <h3 style="margin-bottom: 1.3rem;">Why Choose Our Vocational Training Center?</h3>
      <div class="info-cards">
        <div class="info-card">
          <img src="https://picsum.photos/100/100?grayscale&random=14" alt="Flexible Programs" width="78" height="78" />
          <h4 style="margin:1rem 0 0.4rem; color:#009ddc;">Diverse Programs</h4>
          <p style="margin:0;">From IT to Healthcare, choose from specialized FP tracks to match your ambitions.</p>
        </div>
        <div class="info-card">
          <img src="https://picsum.photos/100/100?grayscale&random=7" alt="Expert Faculty" width="78" height="78" />
          <h4 style="margin:1rem 0 0.4rem; color:#009ddc;">Expert Faculty</h4>
          <p style="margin:0;">Learn from industry-experienced instructors committed to your professional success.</p>
        </div>
        <div class="info-card">
          <img src="https://picsum.photos/100/100?grayscale&random=9" alt="Job Oriented" width="78" height="78" />
          <h4 style="margin:1rem 0 0.4rem; color:#009ddc;">Career-Focused</h4>
          <p style="margin:0;">Gain hands-on skills and job-ready certification to accelerate your career launch.</p>
        </div>
      </div>
    </section>
    </main>
    
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> "2DAW. Todos los derechos reservados." %></p>
    </footer>
    
  
  </body>
</html>
