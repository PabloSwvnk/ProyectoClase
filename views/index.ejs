<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>

  <body>
    <nav style="width: 100%; background: #003366; display: flex; justify-content: center; align-items: center; padding: 0.5rem 0; box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 2rem;">
        <li><a href="#about" style="color: #fff; text-decoration: none; font-weight: 500; font-size: 1.1rem; transition: color 0.2s;">About Us</a></li>
        <li><a href="#programs" style="color: #fff; text-decoration: none; font-weight: 500; font-size: 1.1rem; transition: color 0.2s;">Programs</a></li>
        <li><a href="#faculty" style="color: #fff; text-decoration: none; font-weight: 500; font-size: 1.1rem; transition: color 0.2s;">Faculty</a></li>
        <li><a href="#admissions" style="color: #fff; text-decoration: none; font-weight: 500; font-size: 1.1rem; transition: color 0.2s;">Admissions</a></li>
        <li><a href="#contact" style="color: #fff; text-decoration: none; font-weight: 500; font-size: 1.1rem; transition: color 0.2s;">Contact</a></li>
      </ul>
    </nav>

    <header style="width: 100%; height: 250px; background-image: url('https://images.unsplash.com/photo-1464983953574-0892a716854b?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
      <h2 style="color: white; background: rgba(0,0,0,0.60); padding: 1rem 2.5rem; border-radius: 10px; font-size: 2.2rem; letter-spacing: 2px;">
        California Vocational Training Institute
      </h2>
    </header>
    
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> "2DAW. Todos los derechos reservados." %></p>
    </footer>
    
  
  </body>
</html>
